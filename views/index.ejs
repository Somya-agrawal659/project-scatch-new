<%- include('./partials/header') %>

<style>
    @keyframes fade-in-up {
        from { opacity: 0; transform: translateY(18px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes float-ambient {
        0%, 100% { transform: translate(0, 0) scale(1); opacity: .55; }
        50% { transform: translate(35px, 25px) scale(1.08); opacity: .75; }
    }

    .login-page { background: #fbf9f5; color: #1b1c1a; font-family: "Plus Jakarta Sans", sans-serif; }
    .login-page .ambient { animation: float-ambient 20s ease-in-out infinite; }
    .login-page .reveal { animation: fade-in-up .9s cubic-bezier(.16, 1, .3, 1) both; }
    .login-page .reveal-delay { animation: fade-in-up 1.1s .15s cubic-bezier(.16, 1, .3, 1) both; }
    .login-page input { box-sizing: border-box; }

    @media (prefers-reduced-motion: reduce) {
        .login-page .ambient, .login-page .reveal, .login-page .reveal-delay { animation: none; }
    }
</style>

<main class="login-page relative min-h-screen overflow-hidden flex flex-col items-center justify-between px-6 py-8 sm:px-10 lg:px-14">
    <div class="ambient pointer-events-none absolute -top-40 -left-40 h-[720px] w-[720px] rounded-full bg-gradient-to-br from-[#e8d2b8]/60 via-[#f4e4cf]/40 to-transparent blur-3xl"></div>
    <div class="ambient pointer-events-none absolute -bottom-48 -right-32 h-[760px] w-[760px] rounded-full bg-gradient-to-tl from-[#ebd0b0]/55 via-[#f5e6d3]/35 to-transparent blur-3xl" style="animation-delay: -8s"></div>

    <header class="reveal relative z-10 flex w-full max-w-6xl flex-col items-center justify-center pt-2 text-center sm:pt-4">
        <div class="relative flex flex-col items-center">
            <div class="mb-3.5 flex h-14 w-14 items-center justify-center rounded-full border border-[#c7a47d]/40 bg-white/75 shadow-[0_4px_16px_-2px_rgba(124,87,48,0.15)]">
                <span class="font-playfair text-2xl text-[#7c5730]">+</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="h-px w-8 bg-gradient-to-r from-transparent to-[#c7a47d]/60 sm:w-12"></span>
                <span class="font-playfair pl-1 text-lg tracking-[.32em] text-[#050302] sm:text-xl">SCATCH</span>
                <span class="h-px w-8 bg-gradient-to-l from-transparent to-[#c7a47d]/60 sm:w-12"></span>
            </div>
            <span class="mt-1 text-[9px] font-medium uppercase tracking-[.28em] text-[#4e4541]/80"> &amp;</span>
        </div>
    </header>

    <% if(error.length > 0){ %>
        <div class="relative z-20 mx-auto mb-4 rounded-lg bg-[#ba1a1a] px-4 py-3 text-sm text-white shadow-lg" role="alert"><%= error %></div>
    <% } %>

    <div class="reveal-delay relative z-10 my-auto w-full max-w-6xl py-8 sm:py-10">
        <div class="grid grid-cols-1 items-start gap-8 md:grid-cols-2 lg:gap-12">
            <section class="rounded-2xl border border-white/85 bg-white/75 p-8 shadow-[0_12px_40px_-15px_rgba(40,30,20,0.06)] backdrop-blur-xl transition hover:-translate-y-1 sm:p-10">
                <h1 class="mb-1 font-playfair text-[32px] leading-10 text-[#050302]">Welcome to <span class="text-[#7c5730]">Scatch</span></h1>
                <h2 class="mb-6 font-playfair text-2xl leading-8">Create your account</h2>
                <form autocomplete="off" action="/users/register" method="post" class="flex w-full flex-col gap-4">
                    <input required type="text" placeholder="Full Name" name="fullname" class="w-full rounded-xl border border-[#e8e4dc] bg-[#f6f4ee]/80 px-4 py-3.5 text-[#1b1c1a] placeholder:text-[#7f7570]/70 focus:border-[#7c5730] focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#7c5730]/15">
                    <input required type="email" placeholder="Email" name="email" class="w-full rounded-xl border border-[#e8e4dc] bg-[#f6f4ee]/80 px-4 py-3.5 text-[#1b1c1a] placeholder:text-[#7f7570]/70 focus:border-[#7c5730] focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#7c5730]/15">
                    <input required type="password" placeholder="Password" name="password" class="w-full rounded-xl border border-[#e8e4dc] bg-[#f6f4ee]/80 px-4 py-3.5 text-[#1b1c1a] placeholder:text-[#7f7570]/70 focus:border-[#7c5730] focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#7c5730]/15">
                    <button type="submit" class="mt-2 w-fit rounded-full bg-[#050302] px-7 py-3.5 font-medium text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-[#221c19]">Create My Account</button>
                </form>
            </section>

            <section class="rounded-2xl border border-white/85 bg-white/75 p-8 shadow-[0_12px_40px_-15px_rgba(40,30,20,0.06)] backdrop-blur-xl transition hover:-translate-y-1 sm:p-10">
                <h2 class="mb-6 font-playfair text-2xl leading-8">Login Your Account</h2>
                <form autocomplete="off" action="/users/login" method="post" class="flex w-full flex-col gap-4">
                    <input required type="email" placeholder="Email" name="email" class="w-full rounded-xl border border-[#e8e4dc] bg-[#f6f4ee]/80 px-4 py-3.5 text-[#1b1c1a] placeholder:text-[#7f7570]/70 focus:border-[#7c5730] focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#7c5730]/15">
                    <input required type="password" placeholder="Password" name="password" class="w-full rounded-xl border border-[#e8e4dc] bg-[#f6f4ee]/80 px-4 py-3.5 text-[#1b1c1a] placeholder:text-[#7f7570]/70 focus:border-[#7c5730] focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#7c5730]/15">
                    <button type="submit" class="mt-2 w-fit rounded-full bg-[#050302] px-9 py-3.5 font-medium text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-[#221c19]">Login</button>
                    <a href="/owners/admin" class="mt-3 w-fit text-xs font-semibold uppercase tracking-[.16em] text-[#7c5730] underline-offset-4 transition hover:text-[#241b16] hover:underline">Owner Portal</a>
                </form>
            </section>
        </div>
    </div>
</main>

<%- include('./partials/footer') %>