<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scatch - My Account</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-[#fcfaf7] px-6 py-10 font-sans text-[#241b16] sm:px-10">
    <main class="mx-auto max-w-3xl">
        <nav class="mb-16 flex items-center justify-between text-sm"><a href="/shop" class="font-serif text-2xl">Scatch</a><div class="flex gap-5"><a href="/cart">Cart</a><a href="/orders">Orders</a><a href="/users/logout" class="text-[#a75c43]">LogOut</a></div></nav>
        <section class="rounded-2xl border border-[#eadfd4] bg-white/80 p-8 shadow-sm sm:p-12">
            <p class="mb-3 text-xs uppercase tracking-[.22em] text-[#8c786e]">Account</p>
            <h1 class="font-serif text-4xl">Welcome, <%= user.fullname %></h1>
            <div class="mt-8 space-y-4 border-t border-[#eee5dc] pt-6 text-sm"><p><span class="text-[#8c786e]">Email</span><br><%= user.email %></p><p><span class="text-[#8c786e]">Orders placed</span><br><%= (user.orders || []).length %></p></div>
            <a class="mt-8 inline-block rounded-full bg-[#2d333b] px-6 py-3 text-sm text-white" href="/orders">View Orders</a>
        </section>
    </main>
</body>
</html>