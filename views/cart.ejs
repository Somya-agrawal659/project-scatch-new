<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scatch - Your Cart</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <style>
        @keyframes orb-float { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(30px, -25px) scale(1.08); } }
        .ambient-orb { animation: orb-float 18s ease-in-out infinite; }
        .luxury-card { background: rgba(255, 255, 255, .88); backdrop-filter: blur(12px); border: 1px solid rgba(236, 228, 216, .75); box-shadow: 0 20px 45px -15px rgba(168, 148, 126, .12), 0 1px 3px rgba(0, 0, 0, .02); }
        @media (prefers-reduced-motion: reduce) { .ambient-orb { animation: none; } }
    </style>
</head>
<body class="relative flex min-h-screen flex-col overflow-x-hidden bg-[#fcfaf7] font-sans text-neutral-800 antialiased">
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden"><div class="ambient-orb absolute -top-24 left-1/4 h-[540px] w-[540px] rounded-full bg-[#f4ebe1] opacity-75 blur-3xl"></div><div class="absolute right-[-80px] top-1/3 h-[600px] w-[600px] rounded-full bg-[#eee5d8] opacity-60 blur-3xl"></div></div>
    <header class="w-full px-6 pb-6 pt-8 sm:px-10 md:px-16"><div class="mx-auto flex max-w-7xl items-center justify-between"><a class="font-serif text-2xl font-medium tracking-wide text-neutral-900" href="/shop">Scatch</a><div class="hidden flex-col items-center justify-center lg:flex"><span class="font-serif font-semibold uppercase tracking-[.32em]">S C A T C H</span><span class="mt-1 text-[9px] font-medium uppercase tracking-[.25em] text-neutral-400">Maison &amp; Atelier</span></div><nav class="flex items-center gap-4 text-xs text-neutral-700 sm:gap-7 sm:text-sm"><a class="transition hover:text-neutral-950" href="/shop">Shop</a><a class="font-medium text-neutral-950" href="/cart">Cart</a><a class="hidden transition hover:text-neutral-950 sm:inline" href="/cart">My Account</a><a class="text-[#b24c3d] transition hover:text-red-700" href="/users/logout">LogOut</a></nav></div></header>

    <main class="mx-auto w-full max-w-7xl flex-1 px-6 pb-16 pt-4 md:px-14">
        <section class="mb-8"><h1 class="font-serif text-3xl font-bold tracking-tight text-neutral-900 md:text-4xl">Your Cart</h1></section>
        <% if(user.cart.length === 0) { %>
            <div class="luxury-card rounded-2xl p-12 text-center"><h2 class="font-serif text-2xl text-neutral-700">Your cart is empty.</h2><a href="/shop" class="mt-5 inline-block rounded-full bg-[#2d333b] px-6 py-3 text-sm text-white transition hover:bg-[#1c1f24]">Shop Now</a></div>
        <% } else { %>
            <% let grandTotal = 0; let totalMrp = 0; let totalDiscount = 0; user.cart.forEach(function(item) { const mrp = Number(item.price) || 0; const discount = Number(item.discount) || 0; const netTotal = Math.max(0, mrp - discount); const itemTotal = netTotal + 20; grandTotal += itemTotal; totalMrp += mrp; totalDiscount += discount; %>
                <div class="luxury-card mb-6 rounded-2xl p-6 md:p-10"><div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-14">
                    <div class="flex flex-col items-center lg:col-span-5"><div class="w-full max-w-[340px] overflow-hidden rounded-xl border border-[#d5c7b5]/70 bg-white shadow-sm"><div class="flex aspect-[4/3] w-full items-center justify-center p-6" style="background-color: <%= item.bgcolor || '#ececeb' %>"><img alt="<%= item.name %>" class="max-h-full max-w-full object-contain drop-shadow-md transition-transform duration-300 hover:scale-105" src="data:image/jpeg;base64,<%= item.image.toString('base64') %>"></div><div class="flex flex-col space-y-3 bg-[#2d333b] px-5 py-4 text-white"><div class="flex items-center justify-between"><span class="truncate pr-2 text-sm font-medium tracking-wide"><%= item.name %></span><div class="flex shrink-0 items-center gap-1.5"><a aria-label="Increase quantity" class="flex h-6 w-6 items-center justify-center rounded-full bg-white text-xs font-bold text-[#2d333b]" href="/addtocart/<%= item._id %>">+</a><span class="flex h-6 min-w-[26px] items-center justify-center rounded bg-white px-1.5 text-xs font-semibold text-[#2d333b]">01</span><a aria-label="Remove item" class="flex h-6 w-6 items-center justify-center rounded-full bg-white text-xs font-bold text-[#2d333b]" href="/removefromcart/<%= item._id %>">-</a></div></div><div class="flex items-center justify-between border-t border-white/10 pt-1 text-xs text-neutral-300"><span>Net Total</span><span class="text-sm font-semibold text-white">₹<%= netTotal %></span></div></div></div></div>
                    <div class="flex flex-col justify-between pt-2 lg:col-span-7 lg:pl-4"><div><h2 class="mb-6 font-serif text-xl font-bold text-neutral-900 md:text-2xl">Price Breakdown</h2><div class="space-y-4 text-sm text-neutral-600"><div class="flex justify-between"><span>Total MRP</span><span class="font-medium text-neutral-900">₹<%= mrp %></span></div><div class="flex justify-between"><span>Discount on MRP</span><span class="font-medium text-[#2e7d32]">- ₹<%= discount %></span></div><div class="flex justify-between"><span>Platform Fee</span><span class="font-medium text-neutral-900">₹20</span></div><div class="flex justify-between"><span>Shipping Fee</span><span class="font-medium tracking-wide text-[#2e7d32]">FREE</span></div></div><div class="my-6 border-b border-neutral-200"></div><div class="flex items-center justify-between text-base md:text-lg"><span class="font-bold text-neutral-900">Total Amount</span><span class="text-2xl font-bold tracking-tight text-[#2e7d32]">₹<%= itemTotal %></span></div></div></div>
                </div></div>
            <% }) %>
            <div class="luxury-card flex flex-wrap items-center justify-between gap-4 rounded-2xl px-6 py-5"><div><span class="block text-sm text-neutral-600">Cart summary</span><span class="text-xs text-neutral-400">MRP ₹<%= totalMrp %> - discount ₹<%= totalDiscount %> + platform fees</span></div><div class="text-right"><span class="mr-4 text-lg font-bold text-neutral-900">Grand Total</span><span class="text-2xl font-bold text-[#2e7d32]">₹<%= grandTotal %></span></div></div>
        <% } %>
    </main>
    <footer class="w-full py-6 text-center text-xs font-light text-neutral-400"><span>© Scatch Maison &amp; Atelier. Haute Maroquinerie.</span></footer>
</body>
</html>